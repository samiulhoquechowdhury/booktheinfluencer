{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "generate": { "cache": false },
    "build": { "dependsOn": ["^build", "^generate"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^generate"] },
    "test": { "dependsOn": ["^generate"], "env": ["DATABASE_URL", "REDIS_URL"] }
  }
}
