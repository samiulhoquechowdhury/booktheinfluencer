# apps/api — copy to .env for local runs. Validated at boot by src/config/env.ts.
NODE_ENV=development
PORT=4000
# Local Docker Postgres (docker-compose.yml, host port 5440)
DATABASE_URL=postgresql://talent:talent@localhost:5440/talent_dev?schema=public
# Local Docker Redis (host port 6390) — used by queues once the worker exists
REDIS_URL=redis://localhost:6390
# Comma-separated browser origins allowed to call the API (web + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug
# Auth (AUTH-1..5). Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdefgh
# OTP SMS adapter: console = print codes to the log (development/test only)
SMS_PROVIDER=console
# Encrypts staff authenticator secrets at rest (openssl rand -base64 32)
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1jaGFuZ2UtbWUtMzJieXQ=
# Where invite links point (the token is appended)
INVITE_BASE_URL=http://localhost:3000/invite
# Quotes below this margin (basis points; 1000 = 10%) need super-admin approval. Placeholder until the client decides.
QUOTE_MARGIN_FLOOR_BPS=1000
# Booking desk number shown to customers (required in production)
# SUPPORT_PHONE=+91XXXXXXXXXX
# Payment gateway / e-sign adapters (fake = local test providers; refused in production)
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret-change-me-0001
ESIGN_PROVIDER=fake
ESIGN_WEBHOOK_SECRET=dev-only-esign-webhook-secret-change-me-00001
WEB_BASE_URL=http://localhost:3000
# Staff invites open the admin app (set a password there)
STAFF_INVITE_BASE_URL=http://localhost:3001/invite
# Website on-demand revalidation after catalogue edits (optional; same secret as the website)
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=change-me-32-characters-or-more-0000
