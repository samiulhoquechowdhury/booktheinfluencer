# apps/web — copy to .env.local for local overrides. Validated at boot by lib/env.ts.

# Canonical site origin (metadata, sitemap, JSON-LD). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the browser calls the API.
#   /api/mock (default) — the built-in mock API with the demo account picker.
#   /api/v1             — the real NestJS API through this site's proxy (phone OTP sign-in). Needs API_URL.
NEXT_PUBLIC_API_BASE=/api/mock

# Server-side NestJS API origin. With /api/mock it only serves the public catalogue.
# API_URL=http://localhost:4011

# On-demand revalidation from the API after catalogue edits (same value as the API's REVALIDATE_SECRET; 32+ chars).
# REVALIDATE_SECRET=
