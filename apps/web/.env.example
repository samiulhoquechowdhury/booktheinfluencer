# apps/web — copy to .env.local for local overrides. Validated at boot by lib/env.ts.

# Canonical site origin (metadata, sitemap, JSON-LD). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the browser calls the API. /api/mock is the built-in mock API (default).
NEXT_PUBLIC_API_BASE=/api/mock

# Server-side NestJS API origin (not used until apps/api exists).
# API_URL=http://localhost:4000
